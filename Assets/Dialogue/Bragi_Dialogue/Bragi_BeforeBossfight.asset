  m_Script: {fileID: 11500000, guid: ef4120e8d7cc4784ba80e7aeb2d6d58d, type: 3}
  m_Name: Bragi_BeforeBossfight
  m_EditorClassIdentifier: 
  Repeatable: 0
  Lines:
  - Text: Bragi, I have done it, I can now free my father.
    Speaker: 0
  - Text: Welcome back, child of lies.
    Speaker: 2
  - Text: You seem disturbed.
    Speaker: 1
  - Text: Forgive me.
    Speaker: 2
  - Text: "I would rather bear your anger than watch the realms burn. If your tale
      reaches its final page as you\u2019re trying to do, Ragnar\xF6k will indeed
      awaken. I shall not condemn the world for such a perfect ending."
    Speaker: 2
  - Text: Turn back now and let the prophecy remain unfulfilled.
    Speaker: 2
  - Text: What, no, no no no! I have come so close to freeing my father, I cannot
      stop now? Why else would you let me come this far?
    Speaker: 1
  - Text: I wish to see your tale to its finish, but it is not to be this one, no
      matter how much we want it. You can yet live a life.
    Speaker: 2
