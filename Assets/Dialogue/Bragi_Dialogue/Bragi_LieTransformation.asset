  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef4120e8d7cc4784ba80e7aeb2d6d58d, type: 3}
  m_Name: Bragi_LieTransformation
  m_EditorClassIdentifier: 
  Repeatable: 0
  Lines:
  - Text: "The Son of Lies watches his own image change in the water\u2019s reflection,
      his lycan body becoming smaller until he looks like the younger sister to the
      Queen of Helheim."
    Speaker: 2
  - Text: "Where\u2019s your voice coming from, I heard you before?"
    Speaker: 1
  - Text: Ah, the Son of Lies can indeed hear me. I am Bragi, lord of poets and skalds,
      as well as the man who will tell your tale, little Lie.
    Speaker: 2
  - Text: I see. Is this supposed to occur, this transformation? Is that a part of
      my story?
    Speaker: 1
  - Text: "I do not think a lot of your creation was intentional when Loki\u2019s
      beloved created you. Your story is not predetermined like that."
    Speaker: 2
  - Text: ...
    Speaker: 1
  - Text: The Son of Lies investigates his new body in an attempt to discover who
      he is-
    Speaker: 2
  - Text: Would you prefer Daughter of Lies, little Lie?
    Speaker: 2
  - Text: "I don\u2019t think the epithet of \u2018Son of Lies\u2019 fits this body."
    Speaker: 1
  - Text: "I\u2026 I don\u2019t know."
    Speaker: 1
