  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ef4120e8d7cc4784ba80e7aeb2d6d58d, type: 3}
  m_Name: Huginn_Dialogue
  m_EditorClassIdentifier: 
  Repeatable: 0
  Lines:
  - Text: "You come intent to unleash Ragnar\xF6k, Princess of Hel?"
    Speaker: {fileID: 11400000, guid: afb70e6f906eb6e458cf847a9948c962, type: 2}
  - Text: I do not know of what you speak, nor am I Hel.
    Speaker: {fileID: 11400000, guid: 4f97ef8596ffbe84c8329bcee3fa66b3, type: 2}
  - Text: I see you truly do not comprehend. Prove your body worthy and your mind
      keen in these trials, then you may understand.
    Speaker: {fileID: 11400000, guid: afb70e6f906eb6e458cf847a9948c962, type: 2}
  - Text: Furthermore, you are referred to as Princess of Hel, rather than Queen,
      due to your clear proximity to her.
    Speaker: {fileID: 11400000, guid: afb70e6f906eb6e458cf847a9948c962, type: 2}
  - Text: Do you ever speak plainly?
    Speaker: {fileID: 11400000, guid: 4f97ef8596ffbe84c8329bcee3fa66b3, type: 2}
  - Text: Answer my question first; will you free Loki?
    Speaker: {fileID: 11400000, guid: afb70e6f906eb6e458cf847a9948c962, type: 2}
  - Text: He is my father, I shall not leave him in Aesir chains.
    Speaker: {fileID: 11400000, guid: 4f97ef8596ffbe84c8329bcee3fa66b3, type: 2}
  - Text: Then I must allow you to face the first trial. I see that it is in your
      blood to surround yourself by death, Princess.
    Speaker: {fileID: 11400000, guid: afb70e6f906eb6e458cf847a9948c962, type: 2}
  IsVoiced: 0
  VoiceEventName: 
  VoiceParameterName: 
  OnFinished:
    m_PersistentCalls:
      m_Calls: []
